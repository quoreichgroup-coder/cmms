<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-10-29-task-list-settings" author="qpm">
        <createTable tableName="maintenance_task_list_configuration">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false" primaryKeyName="pk_maintenance_task_list_configuration"/></column>
            <column name="company_id" type="BIGINT"><constraints nullable="false" unique="true" uniqueConstraintName="uk_task_list_configuration_company" foreignKeyName="fk_task_list_configuration_company" references="company(id)"/></column>
            <column name="operation_number_start" type="INT" defaultValueNumeric="10"><constraints nullable="false"/></column>
            <column name="operation_number_increment" type="INT" defaultValueNumeric="10"><constraints nullable="false"/></column>
            <column name="default_workers" type="NUMERIC(10,2)" defaultValueNumeric="1"><constraints nullable="false"/></column>
            <column name="default_work_unit" type="VARCHAR(20)" defaultValue="H"><constraints nullable="false"/></column>
            <column name="default_duration_unit" type="VARCHAR(20)" defaultValue="H"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP" defaultValueDate="CURRENT_TIMESTAMP"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMP" defaultValueDate="CURRENT_TIMESTAMP"><constraints nullable="false"/></column>
            <column name="created_by" type="BIGINT"/>
            <column name="updated_by" type="BIGINT"/>
        </createTable>
    </changeSet>
</databaseChangeLog>
