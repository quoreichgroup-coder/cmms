<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <changeSet id="2026_10_23_document_template_site_scope" author="QPM">
        <addColumn tableName="document_template">
            <column name="site_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="document_template" baseColumnNames="site_id"
                                 referencedTableName="site" referencedColumnNames="id"
                                 constraintName="fk_document_template_site" onDelete="SET NULL"/>
        <createIndex tableName="document_template" indexName="idx_document_template_site_scope">
            <column name="company_id"/>
            <column name="site_id"/>
            <column name="document_type_id"/>
            <column name="status"/>
        </createIndex>
        <sql>DROP INDEX uk_document_template_default_company_type</sql>
        <sql>CREATE UNIQUE INDEX uk_document_template_default_company_type_scope
             ON document_template (company_id, document_type_id, default_scope, COALESCE(site_id, -1))
             WHERE is_default = TRUE AND status = 'PUBLISHED'</sql>
        <rollback>
            <sql>DROP INDEX uk_document_template_default_company_type_scope</sql>
            <sql>CREATE UNIQUE INDEX uk_document_template_default_company_type
                 ON document_template (company_id, document_type_id, default_scope)
                 WHERE is_default = TRUE AND status = 'PUBLISHED'</sql>
            <dropIndex tableName="document_template" indexName="idx_document_template_site_scope"/>
            <dropForeignKeyConstraint baseTableName="document_template" constraintName="fk_document_template_site"/>
            <dropColumn tableName="document_template" columnName="site_id"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
