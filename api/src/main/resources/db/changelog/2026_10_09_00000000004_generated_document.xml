<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <changeSet id="2026_10_09_generated_document_1" author="QPM">
        <createTable tableName="generated_document">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="company_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_generated_document_company" references="company(id)"/>
            </column>
            <column name="document_type" type="VARCHAR(40)"><constraints nullable="false"/></column>
            <column name="source_type" type="VARCHAR(40)"><constraints nullable="false"/></column>
            <column name="source_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="site_id" type="BIGINT"><constraints foreignKeyName="fk_generated_document_site" references="site(id)"/></column>
            <column name="file_name" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="storage_path" type="VARCHAR(1024)"><constraints nullable="false" unique="true"/></column>
            <column name="sha256" type="VARCHAR(64)"><constraints nullable="false"/></column>
            <column name="locale" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="template_version" type="VARCHAR(40)"><constraints nullable="false"/></column>
            <column name="issued_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="issued_by" type="BIGINT"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP" defaultValueDate="CURRENT_TIMESTAMP"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMP" defaultValueDate="CURRENT_TIMESTAMP"><constraints nullable="false"/></column>
            <column name="created_by" type="BIGINT"/>
            <column name="updated_by" type="BIGINT"/>
        </createTable>
        <createIndex tableName="generated_document" indexName="idx_generated_document_source">
            <column name="company_id"/><column name="source_type"/><column name="source_id"/><column name="issued_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
