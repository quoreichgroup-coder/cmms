<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <!-- Optional per-site logo printed on generated documents; the company logo stays the fallback.
         Deleting the file only clears the site's logo. -->
    <changeSet id="2026-11-10-site-logo" author="qpm">
        <addColumn tableName="site">
            <column name="logo_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="site" baseColumnNames="logo_id" constraintName="fk_site_logo"
                                 referencedTableName="file" referencedColumnNames="id" onDelete="SET NULL"/>
        <createIndex tableName="site" indexName="idx_site_logo">
            <column name="logo_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
