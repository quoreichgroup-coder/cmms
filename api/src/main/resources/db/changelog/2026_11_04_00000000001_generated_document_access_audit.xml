<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <changeSet id="2026_11_04_generated_document_access_audit_1" author="QPM">
        <!-- GenerationType.AUTO resolves to this pooled sequence on PostgreSQL. -->
        <createSequence sequenceName="generated_document_access_event_seq" startValue="1" incrementBy="50"/>
        <createTable tableName="generated_document_access_event">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="company_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_generated_document_access_company" references="company(id)"/>
            </column>
            <column name="generated_document_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_generated_document_access_document" references="generated_document(id)"/>
            </column>
            <column name="source_type" type="VARCHAR(40)"><constraints nullable="false"/></column>
            <column name="source_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="actor_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="actor_name" type="VARCHAR(200)"><constraints nullable="false"/></column>
            <column name="outcome" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP" defaultValueDate="CURRENT_TIMESTAMP"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMP" defaultValueDate="CURRENT_TIMESTAMP"><constraints nullable="false"/></column>
            <column name="created_by" type="BIGINT"/>
            <column name="updated_by" type="BIGINT"/>
        </createTable>
        <createIndex tableName="generated_document_access_event" indexName="idx_generated_document_access_document">
            <column name="company_id"/><column name="generated_document_id"/><column name="created_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
