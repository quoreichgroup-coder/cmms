<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-10-19-user-onboarding-state" author="qpm">
        <addColumn tableName="user_settings">
            <column name="onboarding_version" type="INT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="onboarding_status" type="VARCHAR(16)" defaultValue="COMPLETED">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <dropDefaultValue tableName="user_settings" columnName="onboarding_version" columnDataType="INT"/>
        <dropDefaultValue tableName="user_settings" columnName="onboarding_status" columnDataType="VARCHAR(16)"/>
    </changeSet>
</databaseChangeLog>
