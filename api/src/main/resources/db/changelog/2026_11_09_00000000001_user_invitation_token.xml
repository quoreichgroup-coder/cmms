<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <!-- Secret carried by emailed invitation links. Nullable: invitations created before this change,
         or without an email, keep working without a token. -->
    <changeSet id="2026-11-09-user-invitation-token" author="qpm">
        <addColumn tableName="user_invitation">
            <column name="token" type="VARCHAR(64)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
