<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <changeSet id="2026_10_09_inherited_site_scope_1" author="QPM">
        <addColumn tableName="request">
            <column name="site_id" type="BIGINT">
                <constraints foreignKeyName="fk_request_site" references="site(id)"/>
            </column>
        </addColumn>
        <addColumn tableName="work_order_meter_trigger">
            <column name="site_id" type="BIGINT">
                <constraints foreignKeyName="fk_work_order_meter_trigger_site" references="site(id)"/>
            </column>
        </addColumn>
        <createIndex tableName="request" indexName="idx_request_site">
            <column name="site_id"/>
        </createIndex>
        <createIndex tableName="work_order_meter_trigger" indexName="idx_meter_trigger_site">
            <column name="site_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
