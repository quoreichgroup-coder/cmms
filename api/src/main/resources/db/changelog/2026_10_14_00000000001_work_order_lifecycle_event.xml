<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <changeSet id="2026_10_14_work_order_lifecycle_event" author="QPM">
        <createTable tableName="work_order_lifecycle_event">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_work_order_lifecycle_event"/>
            </column>
            <column name="work_order_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_wo_lifecycle_event_wo"
                             references="work_order(id)"/>
            </column>
            <column name="company_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="previous_status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="new_status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="actor_user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="actor_name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="occurred_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="VARCHAR(1000)"/>
        </createTable>
        <createIndex tableName="work_order_lifecycle_event" indexName="idx_wo_lifecycle_event_wo_time">
            <column name="work_order_id"/>
            <column name="occurred_at"/>
        </createIndex>
        <createIndex tableName="work_order_lifecycle_event" indexName="idx_wo_lifecycle_event_company">
            <column name="company_id"/>
        </createIndex>
    </changeSet>
    <changeSet id="2026_10_14_grant_work_order_reopen_permission_to_admin_roles" author="QPM">
        <sql>
            INSERT INTO role_edit_other_permissions (role_id, edit_other_permissions)
            SELECT role.id, 15
            FROM role
            WHERE role.code IN (0, 1)
              AND NOT EXISTS (
                  SELECT 1 FROM role_edit_other_permissions permissions
                  WHERE permissions.role_id = role.id AND permissions.edit_other_permissions = 15
              )
        </sql>
    </changeSet>
</databaseChangeLog>
