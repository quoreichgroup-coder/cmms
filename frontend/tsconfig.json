{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@pdfme/common": ["src/types/pdfme-common.d.ts"],
      "@pdfme/schemas": ["src/types/pdfme-schemas.d.ts"],
      "@pdfme/ui": ["src/types/pdfme-ui.d.ts"]
    },
    "target": "es6",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["src"]
}
