(qpm_web) {
	# Compress text responses (JS, CSS, JSON, HTML, SVG); Caddy skips images, PDFs and WebSocket upgrades.
	encode zstd gzip

	# Build files carry a content hash in their name: cache them for a year.
	@hashed path /static/js/* /static/css/* /static/media/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# The app shell must be revalidated so a deployment is visible on the next load.
	# /api and /storage keep the cache headers set by the API and MinIO.
	@shell not path /api/* /storage/* /static/js/* /static/css/* /static/media/*
	header @shell Cache-Control "no-cache"
}

eam.quoreichgroup.bf {
	import qpm_web
	reverse_proxy nginx:80
}

169-58-86-7.sslip.io {
	encode zstd gzip
	redir /grafana /grafana/ 308
	handle /grafana/* {
		reverse_proxy grafana:3000
	}
	handle {
		reverse_proxy nginx:80
	}
}
